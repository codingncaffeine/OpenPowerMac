<Window x:Class="OpenPowerMac.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPowerMac"
        Icon="pack://application:,,,/OpenPowerMac.ico"
        Width="1024" Height="900" MinWidth="720" MinHeight="560"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="miRom" Header="Choose Boot ROM…" Click="OnChooseRom" />
                <MenuItem x:Name="miCd" Header="Choose CD Image…" Click="OnChooseCd" />
                <!-- Ejecting the CD is how a Mac chooses to boot from its hard
                     disk: Open Firmware prefers the CD while one is in the
                     drive. Without this the only way back to the disk was to
                     edit shell.json. -->
                <MenuItem x:Name="miCdEject" Header="_Eject CD (boot from hard disk)" Click="OnEjectCd" />
                <MenuItem x:Name="miAti" Header="Choose ATI Card ROM…" Click="OnChooseAti" />
                <Separator />
                <!-- The disks. Built on open (OnHardDiskOpened) because the
                     history and the size of each image are facts about the
                     filesystem, not about the last time this window was
                     constructed. -->
                <MenuItem x:Name="miHd" Header="_Hard Disk" SubmenuOpened="OnHardDiskOpened">
                    <MenuItem x:Name="miHdNew" Header="_New Disk Image">
                        <MenuItem Header="_250 MB" Tag="250" Click="OnNewHd" />
                        <MenuItem Header="_500 MB" Tag="500" Click="OnNewHd" />
                        <MenuItem Header="_1 GB" Tag="1024" Click="OnNewHd" />
                        <MenuItem Header="_2 GB" Tag="2048" Click="OnNewHd" />
                    </MenuItem>
                    <MenuItem x:Name="miHdChoose" Header="_Choose Disk Image…" Click="OnChooseHd" />
                    <Separator x:Name="miHdSep" />
                    <MenuItem x:Name="miHdDetach" Header="_Detach (no hard disk)" Click="OnDetachHd" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Machine">
                <MenuItem x:Name="miStart" Header="_Start" Click="OnStart" />
                <MenuItem x:Name="miStop" Header="S_top" Click="OnStop" IsEnabled="False" />
                <Separator />
                <MenuItem x:Name="miAutoBoot" Header="Auto-boot script (display + USB + mac-boot)"
                          IsCheckable="True" Click="OnAutoBootToggled" />
                <Separator />
                <MenuItem x:Name="miSound" Header="_Sound" IsCheckable="True"
                          Click="OnSoundToggled" />
                <Separator />
                <!-- For the machine that stopped doing anything. See opm_diag. -->
                <MenuItem x:Name="miDiag" Header="_Diagnostics — why is it stuck?"
                          Click="OnDiagnostics" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtState" Text="stopped" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <Separator Width="1" Background="{StaticResource BorderBrush}" />
            <StatusBarItem>
                <TextBlock x:Name="txtInsns" Text="0 insns" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtMips" Text="" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtPc" Text="" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtAudio" Text="" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtVideo" Text="no video" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="4" />
                <RowDefinition Height="240" MinHeight="110" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Letterbox}">
                <Grid>
                    <Image x:Name="imgScreen" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel x:Name="pnlNoVideo" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="OpenPowerMac" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="txtHint" Margin="0,10,0,0" FontSize="13" TextAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Machine ▸ Start boots the Sawtooth ROM.&#10;The firmware talks on the serial console below until the display comes up." />
                    </StackPanel>
                    <!-- A machine that can swallow the pointer has to say so,
                         and has to say how to get it back. -->
                    <Border x:Name="brdCapture" VerticalAlignment="Bottom"
                            HorizontalAlignment="Center" Margin="0,0,0,10"
                            Padding="10,4" CornerRadius="3" Opacity="0.82"
                            Background="{StaticResource Surface}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtCapture" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Click the screen to capture the pointer" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Focusable="False" />

            <DockPanel Grid.Row="2" Background="{StaticResource Surface}">
                <DockPanel DockPanel.Dock="Bottom" Margin="6,4,6,6">
                    <Button x:Name="btnSend" DockPanel.Dock="Right" Content="Send" MinWidth="70"
                            Margin="6,0,0,0" Click="OnSend" IsEnabled="False" />
                    <TextBox x:Name="txtInput" FontFamily="Consolas" FontSize="13"
                             VerticalContentAlignment="Center" KeyDown="OnInputKeyDown"
                             ToolTip="One Forth line — Enter sends with CR; ';' splits into separate lines" />
                </DockPanel>
                <TextBox x:Name="txtConsole" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Margin="6,6,6,0"
                         Background="{StaticResource Letterbox}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
