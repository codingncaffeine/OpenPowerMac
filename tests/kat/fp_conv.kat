# P4 FPU conversions and loads/stores: frsp, fctiw[z], lfs/stfs models,
# stfiwx, FP load/store word-alignment rule.

test frsp_truncates_rn
msr=00002000 f2=3FF0000000400000
insn FC601018                     # frsp f3,f2: 1+2^-30 -> 1.0f
expect f3=3FF0000000000000 fpscr=82024000
end

test frsp_overflow_to_inf
msr=00002000 f2=4C70000000000000
insn FC601018                     # 2^200 overflows single -> +inf, OX
expect f3=7FF0000000000000 fpscr=92065000
end

test frsp_exact_single_denorm
msr=00002000 f2=3730000000000000
insn FC601018                     # 2^-140: exact single denorm, no UX
expect f3=3730000000000000 fpscr=00014000
end

test frsp_nan_truncates_payload
msr=00002000 f2=7FF000000FFFFFFF
insn FC601018                     # SNaN: quiet + payload cut to single width
expect f3=7FF8000000000000 fpscr=A1011000
end

test fctiwz_truncates
msr=00002000 f2=C006000000000000
insn FC60101E                     # fctiwz f3,f2: -2.75 -> -2
expect f3=FFF80000FFFFFFFE fpscr=82020000
end

test fctiw_ties_to_even
msr=00002000 f2=4004000000000000
insn FC60101C                     # fctiw f3,f2: 2.5 -> 2 in RN
expect f3=FFF8000000000002 fpscr=82020000
end

test fctiw_exact
msr=00002000 f2=C01C000000000000
insn FC60101C                     # -7.0 -> -7
expect f3=FFF80000FFFFFFF9 fpscr=00000000
end

test fctiw_large_vxcvi
msr=00002000 f2=4270000000000000
insn FC60101C                     # 2^40 -> 0x7FFFFFFF, VXCVI
expect f3=FFF800007FFFFFFF fpscr=A0000100
end

test fctiw_negative_large_vxcvi
msr=00002000 f2=C270000000000000
insn FC60101C                     # -2^40 -> 0x80000000, VXCVI
expect f3=FFF8000080000000 fpscr=A0000100
end

test fctiw_nan_vxcvi
msr=00002000 f2=7FF8000000000000
insn FC60101C                     # QNaN -> 0x80000000
expect f3=FFF8000080000000 fpscr=A0000100
end

test fctiw_int_min_exact
msr=00002000 f2=C1E0000000000000
insn FC60101C                     # -2^31 converts exactly
expect f3=FFF8000080000000 fpscr=00000000
end

test lfs_normal
msr=00002000 r4=00003000
mem@00003000=3F800000
insn C0640000                     # lfs f3,0(r4): 1.0f -> 1.0
expect f3=3FF0000000000000
end

test lfs_min_denorm
msr=00002000 r4=00003000
mem@00003000=00000001
insn C0640000                     # 2^-149 normalizes into double
expect f3=36A0000000000000
end

test lfs_inf_and_nan
msr=00002000 r4=00003000
mem@00003000=FF800000
insn C0640000                     # -inf
expect f3=FFF0000000000000
end

test lfd_direct
msr=00002000 r4=00003000
mem@00003000=402499999999999A
insn C8640000                     # lfd f3,0(r4)
expect f3=402499999999999A
end

test stfs_truncates_not_rounds
msr=00002000 r4=00003000 f3=3FFFFFFFFFFFFFFF
insn D0640000                     # stfs f3,0(r4): just under 2.0, truncated
expect mem@00003000=3FFFFFFF
end

test stfs_denormalizes
msr=00002000 r4=00003000 f3=3730000000000000
insn D0640000                     # 2^-140 -> single denorm 0x200
expect mem@00003000=00000200
end

test stfs_tiny_flushes
msr=00002000 r4=00003000 f3=3600000000000000 mem@00003000=FFFFFFFF
insn D0640000                     # below exp 874: model fixed point = +0
expect mem@00003000=00000000
end

test stfd_direct
msr=00002000 r4=00003000 f3=123456789ABCDEF0
insn D8640000                     # stfd f3,0(r4)
expect mem@00003000=123456789ABCDEF0
end

test stfiwx_low_word
msr=00002000 r4=00003000 f3=FFF80000DEADBEEF
insn 7C6027AE                     # stfiwx f3,0,r4
expect mem@00003000=DEADBEEF
end

test lfd_unaligned_alignment_exc
msr=00002000 r4=00003002
insn C8640000                     # lfd from a non-word-aligned EA
expect pc=00000600 srr0=00001000 srr1=00002000 msr=00000000 dar=00003002 dsisr=00002464
end
