# P4 FPSCR instructions, enabled-exception suppression, and the
# floating-point enabled program exception.

test mffs_upper_word_receipt
msr=00002000 fpscr=A1011000
insn FC60048E                     # mffs f3
expect f3=FFF80000A1011000 fpscr=A1011000
end

test mtfsb1_sets_ox_and_fx
msr=00002000
insn FC60004C                     # mtfsb1 3 (OX): implicit FX too
expect fpscr=90000000
end

test mtfsb1_fex_unalterable
msr=00002000
insn FC20004C                     # mtfsb1 1 (FEX): no effect
expect fpscr=00000000
end

test mtfsb0_clears
msr=00002000 fpscr=90000000
insn FC60008C                     # mtfsb0 3 clears OX; FX stays
expect fpscr=80000000
end

test mtfsfi_sets_rn
msr=00002000
insn FF80110C                     # mtfsfi 7,1: RN = round toward zero
expect fpscr=00000001
end

test mtfsfi_field0_fx_writable_vx_not
msr=00002000
insn FC00F10C                     # mtfsfi 0,15: FX/OX written, FEX/VX ignored
expect fpscr=90000000
end

test mtfsf_full_write
msr=00002000 f2=00000000000000A2
insn FDFE158E                     # mtfsf 0xFF,f2: VE|UE|RN=2 from frB
expect fpscr=000000A2
end

test mcrfs_copies_and_clears
msr=00002000 fpscr=A1011000
insn FD840080                     # mcrfs cr3,cr1: field 1 -> CR, VXSNAN cleared
expect cr=00010000 fpscr=80011000
end

test mcrfs_field0_keeps_derived
msr=00002000 fpscr=B0211000
insn FD800080                     # mcrfs cr3,cr0: FX/OX cleared, VX stays
expect cr=000B0000 fpscr=20211000
end

test ve_suppresses_result
msr=00002000 f1=7FF0000000000001 f2=3FF0000000000000 f3=1111111111111111 fpscr=00000080
insn FC61102A                     # enabled invalid: frD and FPRF untouched
expect f3=1111111111111111 fpscr=E1000080
end

test ze_suppresses_result
msr=00002000 f1=3FF0000000000000 f2=0000000000000000 f3=1111111111111111 fpscr=00000010
insn FC611024                     # enabled zero-divide: frD untouched
expect f3=1111111111111111 fpscr=C4000010
end

test xe_enabled_delivers_and_flags_fex
msr=00002000 f1=3FF0000000000000 f2=3CA0000000000000 fpscr=00000008
insn FC61102A                     # enabled inexact still writes frD
expect f3=3FF0000000000000 fpscr=C2024008
end

test fp_enabled_program_exception
msr=00002900 f1=7FF0000000000001 f2=3FF0000000000000 f3=1111111111111111 fpscr=00000080
insn FC61102A                     # FE0|FE1 set: precise FP-enabled trap
expect pc=00000700 srr0=00001000 srr1=00102900 msr=00000000 f3=1111111111111111 fpscr=E1000080
end

test mtfsf_composing_fex_traps
msr=00002900 f2=0000000001000080
insn FDFE158E                     # mtfsf writes VXSNAN+VE: FEX forms -> trap
expect pc=00000700 srr0=00001000 srr1=00102900 fpscr=61000080
end
