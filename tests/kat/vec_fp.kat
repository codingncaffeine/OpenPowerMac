# P5 AltiVec float lanes: single precision, always round-to-nearest, no
# FPSCR interaction; NJ flushes denorm inputs and results.

test vaddfp_exact
msr=02000000 v1=3F8000003F8000003F8000003F800000 v2=40000000400000004000000040000000
insn 1061100A                     # vaddfp v3,v1,v2: 1+2=3
expect v3=40400000404000004040000040400000
end

test vmaddfp_is_fused
msr=02000000 v1=3F8008003F8008003F8008003F800800 v2=3F8008003F8008003F8008003F800800 v4=BF800000BF800000BF800000BF800000
insn 106120AE                     # (1+2^-12)^2 - 1: only a fused madd keeps 2^-24
expect v3=3A0004003A0004003A0004003A000400
end

test vnmsubfp_negates
msr=02000000 v1=40000000400000004000000040000000 v2=40400000404000004040000040400000 v4=3F8000003F8000003F8000003F800000
insn 106120AF                     # -(2*3 - 1) = -5
expect v3=C0A00000C0A00000C0A00000C0A00000
end

test vmaxfp_nan_and_order
msr=02000000 v1=7FC000013F800000C000000040400000 v2=3F800000400000003F800000C0400000
insn 1061140A                     # vmaxfp v3,v1,v2
expect v3=7FC00001400000003F80000040400000
end

test vaddfp_java_keeps_denorm
msr=02000000 v1=00000001000000010000000100000001 v2=00000000000000000000000000000000
insn 1061100A                     # NJ=0: gradual underflow preserved
expect v3=00000001000000010000000100000001
end

test vaddfp_nj_flushes
msr=02000000 vscr=00010000 v1=00000001000000010000000100000001 v2=00000000000000000000000000000000
insn 1061100A                     # NJ=1: denorm inputs flush to +0
expect v3=00000000000000000000000000000000 vscr=00010000
end

test vctsxs_saturates
msr=02000000 v2=4F800000CF8000003F800000C0A00000
insn 106013CA                     # vctsxs v3,v2,0
expect v3=7FFFFFFF8000000000000001FFFFFFFB vscr=00000001
end

test vctuxs_scale_and_floor
msr=02000000 v2=3F800000BF8000004000000000000000
insn 1061138A                     # vctuxs v3,v2,1: value*2, negatives clamp
expect v3=00000002000000000000000400000000 vscr=00000001
end

test vrfin_ties_to_even
msr=02000000 v2=4020000040600000C02000003F000000
insn 1060120A                     # 2.5->2, 3.5->4, -2.5->-2, 0.5->0
expect v3=4000000040800000C000000000000000
end

test vrefp_reciprocal
msr=02000000 v2=408000003F8000000000000080000000
insn 1060110A                     # vrefp: 1/4, 1/1, 1/+0, 1/-0
expect v3=3E8000003F8000007F800000FF800000
end

test vcmpbfp_bounds
msr=02000000 v1=4040000040A00000C0A00000C0400000 v2=40800000408000004080000040800000
insn 106117C6                     # vcmpbfp. bound=4: 3 in, 5 le, -5 ge, -3 in
expect v3=00000000800000004000000000000000 cr=00000000
end

test vcmpbfp_all_in_cr6
msr=02000000 v1=404000003F800000C0400000BF800000 v2=40800000408000004080000040800000
insn 106117C6                     # all lanes within ±4
expect v3=00000000000000000000000000000000 cr=00000020
end

test vcmpgtfp_mixed
msr=02000000 v1=404000003F8000007FC0000040400000 v2=3F800000404000003F8000003F800000
insn 106116C6                     # vcmpgtfp. with a NaN lane (false)
expect v3=FFFFFFFF0000000000000000FFFFFFFF cr=00000000
end
