# P5 AltiVec integer/permute/pack: element numbering is big-endian
# (element 0 = leftmost hex pair). MSR[VEC]=0x02000000 throughout.

test vaddubm_wraps
msr=02000000 v1=00112233445566778899AABBCCDDEEFF v2=01010101010101010101010101010101
insn 10611000                     # vaddubm v3,v1,v2
expect v3=0112233445566778899AABBCCDDEEF00 vscr=00000000
end

test vaddubs_saturates
msr=02000000 v1=F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0 v2=20202020202020202020202020202020
insn 10611200                     # vaddubs v3,v1,v2
expect v3=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF vscr=00000001
end

test vaddubs_borderline_no_sat
msr=02000000 v1=FEFEFEFEFEFEFEFEFEFEFEFEFEFEFEFE v2=01010101010101010101010101010101
insn 10611200                     # results equal the max but nothing clamped
expect v3=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF vscr=00000000
end

test vaddsws_clamps_positive
msr=02000000 v1=7FFFFFFF7FFFFFFF7FFFFFFF7FFFFFFF v2=00000001000000010000000100000001
insn 10611380                     # vaddsws v3,v1,v2
expect v3=7FFFFFFF7FFFFFFF7FFFFFFF7FFFFFFF vscr=00000001
end

test vsubsws_clamps_negative
msr=02000000 v1=80000000800000008000000080000000 v2=00000001000000010000000100000001
insn 10611780                     # vsubsws v3,v1,v2
expect v3=80000000800000008000000080000000 vscr=00000001
end

test vsububs_floors_at_zero
msr=02000000 v1=10101010101010101010101010101010 v2=20202020202020202020202020202020
insn 10611600                     # vsububs v3,v1,v2
expect v3=00000000000000000000000000000000 vscr=00000001
end

test vmaxsb_signed
msr=02000000 v1=807F01FF807F01FF807F01FF807F01FF v2=00000000000000000000000000000000
insn 10611102                     # vmaxsb v3,v1,v2
expect v3=007F0100007F0100007F0100007F0100
end

test vminub_unsigned
msr=02000000 v1=807F01FF807F01FF807F01FF807F01FF v2=10101010101010101010101010101010
insn 10611202                     # vminub v3,v1,v2
expect v3=10100110101001101010011010100110
end

test vavgub_rounds_up
msr=02000000 v1=01FF050001FF050001FF050001FF0500 v2=02000600020006000200060002000600
insn 10611402                     # vavgub: (a+b+1)>>1
expect v3=02800600028006000280060002800600
end

test vmuleub_even_bytes
msr=02000000 v1=02000300FF000A00020003000A000500 v2=04000500FF000B00040005000B000700
insn 10611208                     # vmuleub v3,v1,v2
expect v3=0008000FFE01006E0008000F006E0023
end

test vnor_basic
msr=02000000 v1=F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0 v2=0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F
insn 10611504                     # vnor v3,v1,v2
expect v3=00000000000000000000000000000000
end

test vmrghb_interleaves
msr=02000000 v1=000102030405060708090A0B0C0D0E0F v2=101112131415161718191A1B1C1D1E1F
insn 1061100C                     # vmrghb v3,v1,v2
expect v3=00100111021203130414051506160717
end

test vperm_selects
msr=02000000 v1=000102030405060708090A0B0C0D0E0F v2=101112131415161718191A1B1C1D1E1F v4=1F1E1D1C1B1A19181716151413121110
insn 1061112B                     # vperm v3,v1,v2,v4: reversed vB
expect v3=1F1E1D1C1B1A19181716151413121110
end

test vsel_mask
msr=02000000 v1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA v2=55555555555555555555555555555555 v4=FF00FF00FF00FF00FF00FF00FF00FF00
insn 1061112A                     # vsel v3,v1,v2,v4: vB where mask=1
expect v3=55AA55AA55AA55AA55AA55AA55AA55AA
end

test vsldoi_shift3
msr=02000000 v1=000102030405060708090A0B0C0D0E0F v2=101112131415161718191A1B1C1D1E1F
insn 106110EC                     # vsldoi v3,v1,v2,3
expect v3=030405060708090A0B0C0D0E0F101112
end

test vspltb_element5
msr=02000000 v2=000102030405060708090A0B0C0D0E0F
insn 1065120C                     # vspltb v3,v2,5
expect v3=05050505050505050505050505050505
end

test vspltisw_neg7
msr=02000000
insn 1079038C                     # vspltisw v3,-7
expect v3=FFFFFFF9FFFFFFF9FFFFFFF9FFFFFFF9
end

test vupkhsb_sign_extends
msr=02000000 v2=807F01FF000102FE0000000000000000
insn 1060120E                     # vupkhsb v3,v2
expect v3=FF80007F0001FFFF000000010002FFFE
end

test vpkshss_clamps
msr=02000000 v1=7FFF80000123FFFF7FFF80000123FFFF v2=00FF010200FF010200FF010200FF0102
insn 1061118E                     # vpkshss v3,v1,v2
expect v3=7F807FFF7F807FFF7F7F7F7F7F7F7F7F vscr=00000001
end

test vsumsws_accumulates
msr=02000000 v1=00000001000000020000000300000004 v2=0000000000000000000000000000000A
insn 10611788                     # vsumsws v3,v1,v2: 1+2+3+4+10 in word 3
expect v3=00000000000000000000000000000014
end

test vmsumubm_dots
msr=02000000 v1=01020304010203040102030401020304 v2=01010101020202020303030304040404 v4=00000000000000000000000000000001
insn 10611124                     # vmsumubm v3,v1,v2,v4
expect v3=0000000A000000140000001E00000029
end

test vcmpequb_all_true_cr6
msr=02000000 v1=42424242424242424242424242424242 v2=42424242424242424242424242424242
insn 10611406                     # vcmpequb. v3,v1,v2
expect v3=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF cr=00000080
end

test vcmpgtsw_all_false_cr6
msr=02000000 v1=00000001000000010000000100000001 v2=00000002000000020000000200000002
insn 10611786                     # vcmpgtsw. v3,v1,v2
expect v3=00000000000000000000000000000000 cr=00000020
end

test vcmpequb_mixed
msr=02000000 v1=42004200420042004200420042004200 v2=42424242424242424242424242424242
insn 10611406                     # vcmpequb. alternating
expect v3=FF00FF00FF00FF00FF00FF00FF00FF00 cr=00000000
end

test vsl_bits3
msr=02000000 v1=8000000000000000000000000000FFFF v2=00000000000000000000000000000003
insn 106111C4                     # vsl v3,v1,v2 by 3 bits
expect v3=0000000000000000000000000007FFF8
end

test vslo_two_octets
msr=02000000 v1=000102030405060708090A0B0C0D0E0F v2=00000000000000000000000000000010
insn 1061140C                     # vslo v3,v1,v2: shb=2
expect v3=02030405060708090A0B0C0D0E0F0000
end

test mfvscr_reads
msr=02000000 vscr=00010001
insn 10600604                     # mfvscr v3
expect v3=00000000000000000000000000010001
end

test mtvscr_masks
msr=02000000 v2=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
insn 10001644                     # mtvscr v2: only NJ|SAT stick
expect vscr=00010001
end

test lvx_truncates_ea
msr=02000000 r4=00003007
mem@00003000=000102030405060708090A0B0C0D0E0F
insn 7C6020CE                     # lvx v3,0,r4
expect v3=000102030405060708090A0B0C0D0E0F
end

test stvx_stores
msr=02000000 r4=00003000 v3=DEADBEEFCAFEBABE0123456789ABCDEF
insn 7C6021CE                     # stvx v3,0,r4
expect mem@00003000=DEADBEEFCAFEBABE0123456789ABCDEF
end

test lvebx_places_element
msr=02000000 r4=00003005
mem@00003005=AB
insn 7C60200E                     # lvebx v3,0,r4 -> byte element 5
expect v3=0000000000AB00000000000000000000
end

test lvsl_permute_vector
msr=02000000 r4=00003003
insn 7C60200C                     # lvsl v3,0,r4: sh=3
expect v3=030405060708090A0B0C0D0E0F101112
end
